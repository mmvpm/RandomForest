{
  "lines": [
    {
      "speaker": "Голос",
      "text": "Хахахаха"
    },
    {
      "speaker": "Голос",
      "text": "Повёлся?"
    },
    {
      "speaker": "Голос",
      "text": "Страшно потерять прогресс прохождения?"
    },
    {
      "speaker": "Голос",
      "text": "Хахаха"
    },
    {
      "speaker": "Голос",
      "text": "Решил чутка потроллить :)"
    },
    {
      "speaker": "Голос",
      "text": "Извини, не удержался"
    },
    {
      "speaker": "Голос",
      "text": "Не, ну а что ты хотел?"
    },
    {
      "speaker": "Голос",
      "text": "Думал, тут щас будет глубокая драма про свободу воли и гуманизм?"
    },
    {
      "speaker": "Голос",
      "text": "Хахахах, не, бред какой-то"
    },
    {
      "speaker": "Голос",
      "text": "Это просто очередной 2D-платформер, самый обыкновенный"
    },
    {
      "speaker": "Голос",
      "text": "Ноль смысла"
    },
    {
      "speaker": "Голос",
      "text": "Абсолютно"
    },
    {
      "speaker": "Голос",
      "text": "Ну разве что небольшой твист в конце :)"
    },
    {
      "speaker": "Голос",
      "text": "Весь твой прогресс я вернул, не беспокойся"
    },
    {
      "speaker": "Голос",
      "text": "Всё"
    },
    {
      "speaker": "Голос",
      "text": "Теперь точно конец"
    },
    {
      "speaker": "Голос",
      "text": "Пока"
    }
  ]
}
