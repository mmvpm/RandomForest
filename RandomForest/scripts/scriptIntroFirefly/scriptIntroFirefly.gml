    var sample = clamp(frame, 0, 69)
    var first = floor(sample)
    var values = positions[axis]
    return lerp(values[first], values[min(first + 1, 69)], sample - first)
}

/// Supplies the balanced travelled fraction for the existing ember trail.
function funIntroFlightProgress(frame) {
    return funIntroFlightSample(frame, 2)
}

/// Reveals each letter after the light passes its horizontal position below the title.
function funIntroFlightFrameAtX(px) {
    if (px <= funIntroFlightSample(0, 0)) return 0
    for (var i = 1; i <= 69; ++i) {
        var current = funIntroFlightSample(i, 0)
        if (current < px) continue;
        var previous = funIntroFlightSample(i - 1, 0)
        return i - 1 + (px - previous) / max(0.000001, current - previous)
    }
    return 69
}

/// Passes under the title, then holds the core still at the approved endpoint.
function funIntroFireflyDraw(frame, alpha, ink) {
    var progress = funIntroFlightProgress(frame)
    for (var i = 8; i >= 0; --i) {
        var px = funIntroFlightSample(frame - i * 2, 0)
        var py = funIntroFlightSample(frame - i * 2, 1)
        if (i == 0) funIntroGlow(px, py, alpha, ink)
        else if (frame - i * 2 < 69) {
            draw_set_color(ink)
            draw_set_alpha(alpha * (1 - i / 9) * 0.18 * (1 - min(progress, 1) * 0.6))
            draw_point(round(px), round(py))
        }
    }
}
