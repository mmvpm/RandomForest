        169.5450886100, 172.6578272600, 175.8176623300, 179.0295990500, 182.3033372500, 185.6503273000, 189.0800540900,
        192.5997053600, 196.2165616200, 199.9390797200, 203.7739973100, 207.7220006300, 211.7766936400, 215.9293559400,
        220.1774712800, 224.5313212800, 229.0112234900, 233.6349267200, 238.4068710900, 243.3228282400, 248.3880167800,
        253.6288499300, 259.0835292000, 264.7819043900, 270.7336888200, 276.9274278000, 283.3324564300, 289.9024717900,
        296.5832796300, 303.3227675500, 310.0767517100, 316.8080121800, 323.4931546600, 330.1316963500, 336.7268706000,
        343.3119813800, 349.9815254600, 356.7974607700, 363.8018185700, 371.0160542200, 378.4337621200, 386.0000000000
    ], [
        114.0000000000, 115.2296494800, 116.4649417600, 117.7047630300, 118.9475132700, 120.1912650700, 121.4343097900,
        122.6756821200, 123.9151962100, 125.1529912800, 126.3890334100, 127.6229039300, 128.8538824700, 130.0812310800,
        131.3044600700, 132.5231898400, 133.7364831600, 134.9422808000, 136.1376228100, 137.3195750000, 138.4861457800,
        139.6364949400, 140.7702549300, 141.8865345900, 142.9836566300, 144.0600645600, 145.1154112500, 146.1503560600,
        147.1650530300, 148.1581823800, 149.1276833900, 150.0721238000, 150.9910070800, 151.8836486900, 152.7480826900,
        153.5810684200, 154.3787268500, 155.1367013300, 155.8494929900, 156.5098873900, 157.1093783400, 157.6394750400,
        158.0928499900, 158.4632397100, 158.7439054300, 158.9260701000, 158.9990959200, 158.9519990600, 158.7737588900,
        158.4513144300, 157.9677133000, 157.3030499300, 156.4375035200, 155.3546289500, 154.0444234200, 152.5057142000,
        150.7465717600, 148.7823377700, 146.6329904700, 144.3218175600, 141.8712514800, 139.2970541300, 136.6136441500,
        133.8223123900, 130.8952491700, 127.8154308300, 124.5743133400, 121.1743743000, 117.6343085200, 114.0000000000
    ], [
        0.0000000000, 0.0091446487, 0.0183368637, 0.0275741285, 0.0368504616, 0.0461575505, 0.0554887882,
        0.0648432246, 0.0742259412, 0.0836447539, 0.0931065197, 0.1026155305, 0.1121741226, 0.1217848699,
        0.1314527373, 0.1411841370, 0.1509816481, 0.1608392010, 0.1707433585, 0.1806805438, 0.1906448136,
        0.2006402253, 0.2106756868, 0.2207564181, 0.2308811975, 0.2410502980, 0.2512763631, 0.2615841389,
        0.2719968184, 0.2825257365, 0.2931767641, 0.3039653624, 0.3149226350, 0.3260852786, 0.3374831969,
        0.3491385788, 0.3610739792, 0.3733159633, 0.3858856757, 0.3987849314, 0.4119932958, 0.4254839344,
        0.4392513427, 0.4533324417, 0.4677973967, 0.4827090370, 0.4980886583, 0.5139313189, 0.5302642850,
        0.5471851335, 0.5648321566, 0.5833200829, 0.6027019236, 0.6229644929, 0.6440326156, 0.6657778718,
