/// Samples the accepted B02 path and travelled distance, clamped at the sound peak.
function funIntroFlightSample(frame, axis) {
    // X, Y and path distance at 60 Hz, copied from the selected B02 preview.
    static positions = [[
        92.0000000000, 94.5575276700, 97.1287204700, 99.7132464000, 102.3098124600, 104.9164777800, 107.5317799200,
        110.1558423300, 112.7904847900, 115.4383051500, 118.1016460000, 120.7821417200, 123.4808867400, 126.1990523100,
